# Required. Postgres connection string.
# Locally:  postgres://postgres:postgres@localhost:5432/fitcheck
# On Railway: reference the Postgres service rather than pasting a URL —
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# That resolves to the private-network host, which is faster, free of egress
# charges, and needs no TLS.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fitcheck

# Optional. TLS handling is inferred from the host: private/localhost hosts
# connect in the clear, anything else negotiates TLS without verifying the
# certificate (managed Postgres proxies rarely present a publicly-chained one).
# Override with: disable | require | verify
# DATABASE_SSL=require

# Optional. Connection pool ceiling per instance. Keep the total across all
# instances under your Postgres plan's max_connections.
# DATABASE_POOL_MAX=10

# Optional. Whether strangers who find the URL can register. The first account
# is always allowed, or a closed instance could never be set up.
# FITCHECK_SIGNUP=closed

# Optional. AI try-on rendering. Without this the Studio shows a flat-lay
# composite, and the fit scoring — which is the part that answers the actual
# question — works exactly the same.
# FITCHECK_TRYON_PROVIDER=none      # none | fal | fashn | custom
# FAL_KEY=
# FASHN_API_KEY=
# FITCHECK_TRYON_URL=
# FITCHECK_TRYON_KEY=
